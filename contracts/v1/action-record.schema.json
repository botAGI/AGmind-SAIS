{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agmind.local/contracts/v1/action-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "plan_id",
    "plan_hash",
    "state",
    "reason_code",
    "observed_at",
    "previous_record_sha256",
    "record_sha256",
    "details",
    "actuator_key_id",
    "actuator_signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agmind.action-record.v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^ar_[0-9a-f]{32}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^act_[0-9a-f]{32}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan_[0-9a-f]{32}$"
    },
    "plan_hash": {
      "$ref": "#/$defs/sha256"
    },
    "state": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "POLICY_ADMITTED",
        "PREPARED",
        "APPROVED",
        "APPLIED",
        "VERIFIED",
        "EXPIRED",
        "STALE_ABORT",
        "REJECTED",
        "FAILED_DIRTY",
        "EXPIRED_UNAPPLIED"
      ]
    },
    "reason_code": {
      "$ref": "#/$defs/ascii64"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "previous_record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "details": {
      "$ref": "#/$defs/boundedObject"
    },
    "actuator_key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "actuator_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "$defs": {
    "ascii64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[\\x20-\\x7e]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "boundedValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/boundedValue"
          }
        },
        {
          "$ref": "#/$defs/boundedObject"
        }
      ]
    },
    "boundedObject": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/boundedValue"
      }
    }
  }
}
