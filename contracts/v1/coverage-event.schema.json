{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agmind.local/contracts/v1/coverage-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component",
    "kind",
    "severity",
    "opened_at",
    "reason_code"
  ],
  "properties": {
    "component": {
      "$ref": "#/$defs/ascii64"
    },
    "kind": {
      "$ref": "#/$defs/ascii64"
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "WARNING",
        "CRITICAL"
      ]
    },
    "opened_at": {
      "$ref": "#/$defs/timestamp"
    },
    "closed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "affected_source_sequence_start": {
      "$ref": "#/$defs/uint64"
    },
    "affected_source_sequence_end": {
      "$ref": "#/$defs/uint64"
    },
    "dropped_count": {
      "$ref": "#/$defs/uint64"
    },
    "reason_code": {
      "$ref": "#/$defs/ascii64"
    },
    "reconcile_generation": {
      "$ref": "#/$defs/uint64"
    }
  },
  "$defs": {
    "ascii64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[\\x20-\\x7e]+$"
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:[0-9]{3}[1-9]|[0-9]{2}[1-9][0-9]|[0-9][1-9][0-9]{2}|[1-9][0-9]{3})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    }
  }
}
