{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agmind.local/contracts/v1/hunter-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hypotheses",
    "supporting_evidence_ids",
    "refuting_questions",
    "narrative",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agmind.hunter-output.v1"
    },
    "hypotheses": {
      "$ref": "#/$defs/textArray"
    },
    "supporting_evidence_ids": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evt_[0-9a-f]{64}$"
      }
    },
    "refuting_questions": {
      "$ref": "#/$defs/textArray"
    },
    "narrative": {
      "type": "string",
      "maxLength": 8192
    },
    "limitations": {
      "$ref": "#/$defs/textArray"
    }
  },
  "$defs": {
    "textArray": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}
