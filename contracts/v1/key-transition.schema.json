{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agmind.local/contracts/v1/key-transition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "old_key_id",
    "new_key_id",
    "old_epoch",
    "new_epoch",
    "new_public_key",
    "host_id",
    "occurred_at",
    "old_signature",
    "new_signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agmind.key-transition.v1"
    },
    "old_key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "new_key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "old_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "new_epoch": {
      "type": "integer",
      "minimum": 2,
      "maximum": 18446744073709551615
    },
    "new_public_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "host_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "old_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "new_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
