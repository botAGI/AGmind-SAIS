{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agmind.local/contracts/v1/observer-boot-boundary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "reason_code",
    "previous_source_sequence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agmind.observer-boot-boundary.v1"
    },
    "kind": {
      "type": "string",
      "const": "observer_boot_boundary"
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "observer_genesis",
        "kernel_boot_id_changed"
      ]
    },
    "previous_boot_id": {
      "$ref": "#/$defs/uuid4"
    },
    "previous_source_sequence": {
      "$ref": "#/$defs/uint64"
    }
  },
  "oneOf": [
    {
      "properties": {
        "reason_code": {
          "const": "observer_genesis"
        },
        "previous_source_sequence": {
          "const": 0
        }
      },
      "not": {
        "required": [
          "previous_boot_id"
        ]
      }
    },
    {
      "required": [
        "previous_boot_id"
      ],
      "properties": {
        "reason_code": {
          "const": "kernel_boot_id_changed"
        },
        "previous_source_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    }
  ],
  "$defs": {
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
