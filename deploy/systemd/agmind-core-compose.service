[Unit]
Description=AGmind SAIS Core, OPA, adapter, and pinned Falco Compose profile
Documentation=file:/opt/agmind-sais/docs/runbooks/install-single-host.md
Requires=docker.service agmind-observerd.service agmind-actuatord.service
After=docker.service agmind-observerd.service agmind-actuatord.service
PartOf=agmind-sais.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/agmind-sais
# Supplies PCC_POLICY_SHA256 for the policy check below.
EnvironmentFile=/opt/agmind-sais/deploy/versions.env
Environment=COMPOSE_PROJECT_NAME=agmind-sais
Environment=DOCKER_CONFIG=/run/agmind-sais/docker-config
ExecStartPre=/usr/bin/test -S /run/agmind-sais/observer-core/socket
ExecStartPre=/usr/bin/test -S /run/agmind-sais/actuator-intent/socket
ExecStartPre=/usr/bin/test -S /run/agmind-sais/observer-ingest/socket
# Verify the policy OPA is about to load, on EVERY start and not only at preflight. Core
# attests against the copy baked into its image; this is the copy that actually decides.
ExecStartPre=/bin/sh -c 'test "$(sha256sum /opt/agmind-sais/policies/pcc.rego | cut -d" " -f1)" = "${PCC_POLICY_SHA256}"'
ExecStartPre=/usr/bin/docker compose --env-file /etc/agmind-sais/runtime.env -f /opt/agmind-sais/deploy/compose/compose.yaml config --quiet
ExecStart=/usr/bin/docker compose --env-file /etc/agmind-sais/runtime.env -f /opt/agmind-sais/deploy/compose/compose.yaml up --detach --wait --wait-timeout 90
ExecReload=/usr/bin/docker compose --env-file /etc/agmind-sais/runtime.env -f /opt/agmind-sais/deploy/compose/compose.yaml up --detach --wait --wait-timeout 90
ExecStop=/usr/bin/docker compose --env-file /etc/agmind-sais/runtime.env -f /opt/agmind-sais/deploy/compose/compose.yaml stop --timeout 30
RemainAfterExit=yes
Restart=on-failure
RestartSec=2s
TimeoutStartSec=120s
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadOnlyPaths=/opt/agmind-sais /etc/agmind-sais
ReadWritePaths=/var/lib/agmind-sais/core /run/agmind-sais /var/run/docker.sock
TasksMax=64
MemoryMax=256M

[Install]
WantedBy=agmind-sais.target
